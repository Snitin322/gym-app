// Database schema. Conventions (see CLAUDE.md):
// - snake_case table/column names via @@map/@map, camelCase in TypeScript
// - every tenant-owned table gets gym_id (FK to gyms) + an index, and is listed in
//   TENANT_MODELS in src/db/tenant.ts (a test fails if one is missing)
// - money as integer paise, timestamps as timestamptz (UTC), membership dates as date

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  member
  trainer
  admin
  owner

  @@map("role")
}

enum ConsentPurpose {
  terms
  privacy
  whatsapp
  marketing

  @@map("consent_purpose")
}

model Gym {
  id            String   @id @default(uuid()) @db.Uuid
  /// Short stable identifier, e.g. "onthec".
  slug          String   @unique
  name          String
  address       String?
  /// Null when the gym is not GST-registered (issues a bill of supply instead).
  gstin         String?
  /// Registered business name for invoices (falls back to `name`).
  legalName     String?  @map("legal_name")
  city          String?
  pincode       String?
  /// GST state code, e.g. "27" for Maharashtra.
  stateCode     String?  @map("state_code")
  sacCode       String   @default("999723") @map("sac_code")
  /// Invoice numbers look like PREFIX/26-27/0001 (max 16 characters, so 1–5 characters here).
  invoicePrefix String   @default("INV") @map("invoice_prefix")
  contactPhone  String?  @map("contact_phone")
  email         String?
  /// Per-gym settings (e.g. PT late-cancel hours); validated by Zod in the API.
  settings      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users             User[]
  refreshTokens     RefreshToken[]
  consents          Consent[]
  membershipPlans   MembershipPlan[]
  members           Member[]
  memberships       Membership[]
  membershipFreezes MembershipFreeze[]
  payments          Payment[]
  invoices          Invoice[]
  invoiceSequences  InvoiceSequence[]
  ptPackages        PtPackage[]
  ptPurchases       PtPurchase[]
  ptLedger          PtSessionLedger[]
  trainerProfiles   TrainerProfile[]
  trainerHours      TrainerAvailability[]
  trainerTimeOff    TrainerTimeOff[]
  ptSessions        PtSession[]
  workoutExercises  WorkoutExercise[]
  workoutPlans      WorkoutPlan[]
  workoutVersions   WorkoutPlanVersion[]
  workoutLogs       WorkoutLog[]

  @@map("gyms")
}

/// A person's account at one gym. The same phone can have accounts at several gyms.
model User {
  id        String    @id @default(uuid()) @db.Uuid
  gymId     String    @map("gym_id") @db.Uuid
  /// E.164, e.g. +919876543210
  phone     String
  name      String
  role      Role
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set by the account deletion / anonymisation flow; such users cannot log in.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  gym                  Gym                   @relation(fields: [gymId], references: [id], onDelete: Restrict)
  refreshTokens        RefreshToken[]
  consents             Consent[]
  member               Member?
  membershipsCreated   Membership[]          @relation("MembershipCreatedBy")
  freezesCreated       MembershipFreeze[]    @relation("FreezeCreatedBy")
  paymentsRecorded     Payment[]             @relation("PaymentRecordedBy")
  ptClients            PtPurchase[]          @relation("PtTrainer")
  ptSold               PtPurchase[]          @relation("PtSoldBy")
  ptLedgerEntries      PtSessionLedger[]     @relation("PtLedgerBy")
  trainerProfile       TrainerProfile?
  trainerHours         TrainerAvailability[]
  timeOff              TrainerTimeOff[]      @relation("TimeOffTrainer")
  timeOffCreated       TrainerTimeOff[]      @relation("TimeOffCreatedBy")
  ptSessionsTrained    PtSession[]           @relation("PtSessionTrainer")
  ptSessionsBooked     PtSession[]           @relation("PtSessionBookedBy")
  ptSessionsCancelled  PtSession[]           @relation("PtSessionCancelledBy")
  ptSessionsMarked     PtSession[]           @relation("PtSessionMarkedBy")
  ptSessionsResolved   PtSession[]           @relation("PtSessionResolvedBy")
  workoutPlansCreated  WorkoutPlan[]         @relation("WorkoutPlanCreatedBy")
  workoutPlansUpdated  WorkoutPlan[]         @relation("WorkoutPlanUpdatedBy")
  workoutVersionsSaved WorkoutPlanVersion[]
  workoutLogsSaved     WorkoutLog[]

  @@unique([gymId, phone])
  @@index([phone])
  @@map("users")
}

/// Login codes. Not tenant-owned: a code is requested before we know which gym the user wants.
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  /// HMAC of phone + code; the code itself is never stored.
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// Rotating refresh tokens. Each login starts a family; reuse of a rotated token revokes the family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  gymId     String    @map("gym_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  /// SHA-256 of the token; the token itself only lives in the user's cookie.
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// DPDP consent records: one row per purpose and notice version accepted.
model Consent {
  id            String         @id @default(uuid()) @db.Uuid
  gymId         String         @map("gym_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  purpose       ConsentPurpose
  noticeVersion String         @map("notice_version")
  grantedAt     DateTime       @default(now()) @map("granted_at") @db.Timestamptz(3)
  withdrawnAt   DateTime?      @map("withdrawn_at") @db.Timestamptz(3)

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([userId])
  @@map("consents")
}

/// A membership plan the gym sells, e.g. "3 months" for ₹4,500 (GST-inclusive).
/// Plans are deactivated, never deleted, so old memberships keep their history.
model MembershipPlan {
  id             String   @id @default(uuid()) @db.Uuid
  gymId          String   @map("gym_id") @db.Uuid
  name           String
  durationMonths Int      @map("duration_months")
  /// GST-inclusive price in paise.
  pricePaise     Int      @map("price_paise")
  maxFreezeDays  Int      @default(0) @map("max_freeze_days")
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  memberships Membership[]
  payments    Payment[]

  @@unique([gymId, name])
  @@index([gymId])
  @@map("membership_plans")
}

/// Member profile: one per member user account.
model Member {
  id                    String   @id @default(uuid()) @db.Uuid
  gymId                 String   @map("gym_id") @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  joinedOn              DateTime @map("joined_on") @db.Date
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  memberships Membership[]
  payments    Payment[]
  invoices    Invoice[]
  ptPurchases PtPurchase[]
  ptSessions  PtSession[]
  workoutPlan WorkoutPlan?
  workoutLogs WorkoutLog[]

  @@index([gymId])
  @@map("members")
}

/// One purchased membership period. Plan details are copied at sale time so later plan edits
/// don't rewrite history. Status (upcoming/active/frozen/expired/cancelled) is derived from dates.
model Membership {
  id             String    @id @default(uuid()) @db.Uuid
  gymId          String    @map("gym_id") @db.Uuid
  memberId       String    @map("member_id") @db.Uuid
  planId         String    @map("plan_id") @db.Uuid
  planName       String    @map("plan_name")
  durationMonths Int       @map("duration_months")
  pricePaise     Int       @map("price_paise")
  maxFreezeDays  Int       @map("max_freeze_days")
  /// The plan's price at sale; `pricePaise` is lower when a discount was given.
  listPricePaise Int       @map("list_price_paise")
  discountReason String?   @map("discount_reason")
  /// True for memberships sold before the app recorded payments: nothing is due on them.
  paidOutsideApp Boolean   @default(false) @map("paid_outside_app")
  startDate      DateTime  @map("start_date") @db.Date
  /// Last valid day (inclusive), including freeze extensions.
  endDate        DateTime  @map("end_date") @db.Date
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason   String?   @map("cancel_reason")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym       Gym                @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan      MembershipPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy User               @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  freezes   MembershipFreeze[]
  payments  Payment[]

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, endDate])
  @@map("memberships")
}

/// A pause in a membership (inclusive dates). Its length is added to the membership's end date.
model MembershipFreeze {
  id           String   @id @default(uuid()) @db.Uuid
  gymId        String   @map("gym_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  fromDate     DateTime @map("from_date") @db.Date
  toDate       DateTime @map("to_date") @db.Date
  reason       String?
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("FreezeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([membershipId])
  @@map("membership_freezes")
}

enum PaymentMethod {
  cash
  upi
  card
  bank_transfer
  razorpay

  @@map("payment_method")
}

enum PaymentStatus {
  /// Online order created, waiting for Razorpay.
  created
  paid
  failed

  @@map("payment_status")
}

/// Money received (or, for online orders, expected) for a membership. Amounts in paise.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  gymId             String        @map("gym_id") @db.Uuid
  memberId          String        @map("member_id") @db.Uuid
  membershipId      String?       @map("membership_id") @db.Uuid
  amountPaise       Int           @map("amount_paise")
  method            PaymentMethod
  status            PaymentStatus
  /// UPI transaction ID, card slip number, bank reference…
  reference         String?
  note              String?
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  /// Desk staff who took the payment; null for online payments.
  recordedById      String?       @map("recorded_by_id") @db.Uuid
  razorpayOrderId   String?       @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  /// For online orders: the plan being bought; the membership is created when the webhook confirms payment.
  planId            String?       @map("plan_id") @db.Uuid
  /// Set when the payment is for a PT package instead of a membership.
  ptPurchaseId      String?       @map("pt_purchase_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym        Gym             @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member     Member          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membership Membership?     @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  recordedBy User?           @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  invoice    Invoice?
  plan       MembershipPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  ptPurchase PtPurchase?     @relation(fields: [ptPurchaseId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([memberId])
  @@index([membershipId])
  @@index([gymId, paidAt])
  @@map("payments")
}

enum InvoiceKind {
  /// GST tax invoice (gym has a GSTIN).
  tax_invoice
  /// Plain receipt (gym not GST-registered).
  receipt

  @@map("invoice_kind")
}

/// One invoice per paid payment. Everything printed is copied in at issue time, so later edits
/// to the gym, member or plan never change an issued invoice. Invoices are never deleted.
model Invoice {
  id             String      @id @default(uuid()) @db.Uuid
  gymId          String      @map("gym_id") @db.Uuid
  paymentId      String      @unique @map("payment_id") @db.Uuid
  memberId       String      @map("member_id") @db.Uuid
  kind           InvoiceKind
  /// e.g. OG/26-27/0042 — gap-free per gym and financial year.
  number         String
  financialYear  String      @map("financial_year")
  sequence       Int
  /// Date of issue in India.
  issuedOn       DateTime    @map("issued_on") @db.Date
  issuedAt       DateTime    @default(now()) @map("issued_at") @db.Timestamptz(3)
  totalPaise     Int         @map("total_paise")
  taxablePaise   Int         @map("taxable_paise")
  cgstPaise      Int         @map("cgst_paise")
  sgstPaise      Int         @map("sgst_paise")
  /// GST rate in percent at issue (18), or 0 for receipts.
  gstRatePercent Int         @map("gst_rate_percent")
  sacCode        String?     @map("sac_code")
  description    String
  /// Seller (gym) and buyer (member) details as printed.
  seller         Json
  buyer          Json
  paymentMethod  String      @map("payment_method")
  paymentRef     String?     @map("payment_ref")

  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([gymId, financialYear, sequence])
  @@unique([gymId, number])
  @@index([gymId])
  @@index([memberId])
  @@map("invoices")
}

/// Last invoice number used per gym and financial year (incremented in the payment transaction).
model InvoiceSequence {
  gymId         String @map("gym_id") @db.Uuid
  financialYear String @map("financial_year")
  lastNumber    Int    @map("last_number")

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Restrict)

  @@id([gymId, financialYear])
  @@map("invoice_sequences")
}

/// Every verified Razorpay webhook we processed (idempotency and audit). Not tenant-owned:
/// webhooks arrive without a session; the payment they refer to decides the gym.
model WebhookEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  /// The X-Razorpay-Event-Id header.
  eventId    String   @map("event_id")
  type       String
  payload    Json
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

enum PtLedgerReason {
  purchase
  session_completed
  late_cancel
  no_show
  dispute_refund
  adjustment

  @@map("pt_ledger_reason")
}

/// A personal training package the gym sells, e.g. 12 sessions valid for 60 days.
model PtPackage {
  id           String   @id @default(uuid()) @db.Uuid
  gymId        String   @map("gym_id") @db.Uuid
  name         String
  sessionCount Int      @map("session_count")
  validityDays Int      @map("validity_days")
  /// GST-inclusive price in paise.
  pricePaise   Int      @map("price_paise")
  description  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym       Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  purchases PtPurchase[]

  @@unique([gymId, name])
  @@index([gymId])
  @@map("pt_packages")
}

/// A PT package sold to a member, with their trainer. Package details are copied at sale time.
/// The session balance is never stored: it is the sum of the ledger.
model PtPurchase {
  id             String   @id @default(uuid()) @db.Uuid
  gymId          String   @map("gym_id") @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  trainerId      String   @map("trainer_id") @db.Uuid
  packageId      String   @map("package_id") @db.Uuid
  packageName    String   @map("package_name")
  sessionCount   Int      @map("session_count")
  validityDays   Int      @map("validity_days")
  pricePaise     Int      @map("price_paise")
  listPricePaise Int      @map("list_price_paise")
  discountReason String?  @map("discount_reason")
  startDate      DateTime @map("start_date") @db.Date
  /// Last day sessions can be used (inclusive). Admins can extend it.
  expiresOn      DateTime @map("expires_on") @db.Date
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym       Gym               @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  trainer   User              @relation("PtTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  package   PtPackage         @relation(fields: [packageId], references: [id], onDelete: Restrict)
  createdBy User              @relation("PtSoldBy", fields: [createdById], references: [id], onDelete: Restrict)
  ledger    PtSessionLedger[]
  payments  Payment[]
  sessions  PtSession[]

  @@index([gymId])
  @@index([memberId])
  @@index([trainerId])
  @@map("pt_purchases")
}

/// Every change to a PT balance: +N bought, -1 used, +1 dispute upheld, ±N adjustment.
/// Rows are only ever added, never edited or deleted.
model PtSessionLedger {
  id          String         @id @default(uuid()) @db.Uuid
  gymId       String         @map("gym_id") @db.Uuid
  purchaseId  String         @map("purchase_id") @db.Uuid
  /// The PT session this change is about (late cancellation, completion, dispute).
  sessionId   String?        @map("session_id") @db.Uuid
  change      Int
  reason      PtLedgerReason
  note        String?
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  gym       Gym        @relation(fields: [gymId], references: [id], onDelete: Restrict)
  purchase  PtPurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  createdBy User?      @relation("PtLedgerBy", fields: [createdById], references: [id], onDelete: Restrict)
  session   PtSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([gymId])
  @@index([purchaseId])
  @@map("pt_session_ledger")
}

/// Trainer settings (one row per trainer, created when first saved).
model TrainerProfile {
  id             String   @id @default(uuid()) @db.Uuid
  gymId          String   @map("gym_id") @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  /// Length of one PT session; slots are cut at this length.
  sessionMinutes Int      @default(60) @map("session_minutes")
  specialisation String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@map("trainers")
}

/// A trainer's weekly working hours, in India time. Several ranges per day are allowed.
model TrainerAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  gymId       String   @map("gym_id") @db.Uuid
  trainerId   String   @map("trainer_id") @db.Uuid
  /// 1 = Monday … 7 = Sunday.
  weekday     Int
  /// Minutes after midnight (India time), e.g. 360 = 6:00 am.
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  gym     Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)
  trainer User @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([trainerId])
  @@map("trainer_availability")
}

/// Leave or blocked time for a trainer. No sessions can be booked inside it.
model TrainerTimeOff {
  id          String   @id @default(uuid()) @db.Uuid
  gymId       String   @map("gym_id") @db.Uuid
  trainerId   String   @map("trainer_id") @db.Uuid
  startsAt    DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime @map("ends_at") @db.Timestamptz(3)
  reason      String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  gym       Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)
  trainer   User @relation("TimeOffTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  createdBy User @relation("TimeOffCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([trainerId, startsAt])
  @@map("trainer_time_off")
}

enum PtDisputeResolution {
  /// The member was right: the session is given back.
  upheld
  /// The session stays used.
  rejected

  @@map("pt_dispute_resolution")
}

enum PtSessionStatus {
  booked
  cancelled
  completed
  no_show

  @@map("pt_session_status")
}

/// One booked PT session (one member, one trainer). Using up the session is a ledger line, never a counter.
model PtSession {
  id             String               @id @default(uuid()) @db.Uuid
  gymId          String               @map("gym_id") @db.Uuid
  purchaseId     String               @map("purchase_id") @db.Uuid
  trainerId      String               @map("trainer_id") @db.Uuid
  memberId       String               @map("member_id") @db.Uuid
  startsAt       DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime             @map("ends_at") @db.Timestamptz(3)
  status         PtSessionStatus      @default(booked)
  bookedById     String               @map("booked_by_id") @db.Uuid
  cancelledAt    DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelledById  String?              @map("cancelled_by_id") @db.Uuid
  cancelReason   String?              @map("cancel_reason")
  /// Cancelled by the member inside the free-cancel window: the session was used up.
  lateCancel     Boolean              @default(false) @map("late_cancel")
  trainerNotes   String?              @map("trainer_notes")
  /// When the trainer (or desk) marked it completed or no-show; the member can confirm or dispute for 24 hours.
  markedAt       DateTime?            @map("marked_at") @db.Timestamptz(3)
  markedById     String?              @map("marked_by_id") @db.Uuid
  confirmedAt    DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  disputedAt     DateTime?            @map("disputed_at") @db.Timestamptz(3)
  disputeReason  String?              @map("dispute_reason")
  resolvedAt     DateTime?            @map("resolved_at") @db.Timestamptz(3)
  resolvedById   String?              @map("resolved_by_id") @db.Uuid
  resolution     PtDisputeResolution?
  resolutionNote String?              @map("resolution_note")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym         Gym               @relation(fields: [gymId], references: [id], onDelete: Restrict)
  purchase    PtPurchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  trainer     User              @relation("PtSessionTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  bookedBy    User              @relation("PtSessionBookedBy", fields: [bookedById], references: [id], onDelete: Restrict)
  cancelledBy User?             @relation("PtSessionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  markedBy    User?             @relation("PtSessionMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  resolvedBy  User?             @relation("PtSessionResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  ledger      PtSessionLedger[]

  @@index([gymId])
  @@index([purchaseId])
  @@index([memberId, startsAt])
  @@index([trainerId, startsAt])
  @@index([gymId, disputedAt])
  @@map("pt_sessions")
}

enum WorkoutExerciseKind {
  strength
  cardio

  @@map("workout_exercise_kind")
}

/// The gym's exercise library. Plans refer to these; exercises are deactivated, never deleted.
model WorkoutExercise {
  id          String              @id @default(uuid()) @db.Uuid
  gymId       String              @map("gym_id") @db.Uuid
  name        String
  /// e.g. "Chest", "Back", "Legs", "Cardio".
  muscleGroup String?             @map("muscle_group")
  kind        WorkoutExerciseKind
  /// How to do it.
  description String?
  videoUrl    String?             @map("video_url")
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Restrict)

  @@unique([gymId, name])
  @@index([gymId])
  @@map("workout_exercises")
}

/// A weekly workout plan: a template (member_id null) or one member's own copy.
/// The week (days, exercises, sets) is one document, validated by the shared Zod schema.
model WorkoutPlan {
  id          String   @id @default(uuid()) @db.Uuid
  gymId       String   @map("gym_id") @db.Uuid
  /// Set for a member's plan (one per member); null for templates.
  memberId    String?  @unique @map("member_id") @db.Uuid
  name        String
  notes       String?
  week        Json
  /// Goes up by one on every save; earlier versions are kept in workout_plan_versions.
  version     Int      @default(1)
  createdById String   @map("created_by_id") @db.Uuid
  updatedById String   @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym       Gym                  @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member    Member?              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdBy User                 @relation("WorkoutPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User                 @relation("WorkoutPlanUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  versions  WorkoutPlanVersion[]

  @@index([gymId])
  @@map("workout_plans")
}

/// A plan as it was before a later save (who saved that version, and when).
model WorkoutPlanVersion {
  id        String   @id @default(uuid()) @db.Uuid
  gymId     String   @map("gym_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  version   Int
  name      String
  notes     String?
  week      Json
  savedById String   @map("saved_by_id") @db.Uuid
  savedAt   DateTime @map("saved_at") @db.Timestamptz(3)

  gym     Gym         @relation(fields: [gymId], references: [id], onDelete: Restrict)
  plan    WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  savedBy User        @relation(fields: [savedById], references: [id], onDelete: Restrict)

  @@unique([planId, version])
  @@index([gymId])
  @@map("workout_plan_versions")
}

/**
 * What a member did on one date (India), ticked afterwards from their plan. A copy of the exercises,
 * sets, reps and weights, so later plan changes never alter it.
 */
model WorkoutLog {
  id          String   @id @default(uuid()) @db.Uuid
  gymId       String   @map("gym_id") @db.Uuid
  memberId    String   @map("member_id") @db.Uuid
  date        DateTime @db.Date
  /// The plan (and its version) the day came from; null if the plan was later removed.
  planId      String?  @map("plan_id") @db.Uuid
  planVersion Int?     @map("plan_version")
  dayTitle    String?  @map("day_title")
  /// Exercises done (or skipped), validated by the shared Zod schema.
  items       Json
  note        String?
  savedById   String   @map("saved_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym     Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member  Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  savedBy User   @relation(fields: [savedById], references: [id], onDelete: Restrict)

  @@unique([memberId, date])
  @@index([gymId])
  @@map("workout_logs")
}
