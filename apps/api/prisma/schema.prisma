// Database schema. Conventions (see CLAUDE.md):
// - snake_case table/column names via @@map/@map, camelCase in TypeScript
// - every tenant-owned table gets gym_id (FK to gyms) + an index
// - money as integer paise, timestamps as timestamptz (UTC), membership dates as date

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Gym {
  id        String   @id @default(uuid()) @db.Uuid
  /// Short stable identifier, e.g. "onthec".
  slug      String   @unique
  name      String
  address   String?
  /// Null when the gym is not GST-registered (issues a bill of supply instead).
  gstin     String?
  /// Per-gym settings (e.g. PT late-cancel hours); validated by Zod in the API.
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("gyms")
}
