// Database schema. Conventions (see CLAUDE.md):
// - snake_case table/column names via @@map/@map, camelCase in TypeScript
// - every tenant-owned table gets gym_id (FK to gyms) + an index, and is listed in
//   TENANT_MODELS in src/db/tenant.ts (a test fails if one is missing)
// - money as integer paise, timestamps as timestamptz (UTC), membership dates as date

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  member
  trainer
  admin
  owner

  @@map("role")
}

enum ConsentPurpose {
  terms
  privacy
  whatsapp
  marketing

  @@map("consent_purpose")
}

model Gym {
  id            String   @id @default(uuid()) @db.Uuid
  /// Short stable identifier, e.g. "onthec".
  slug          String   @unique
  name          String
  address       String?
  /// Null when the gym is not GST-registered (issues a bill of supply instead).
  gstin         String?
  /// Registered business name for invoices (falls back to `name`).
  legalName     String?  @map("legal_name")
  city          String?
  pincode       String?
  /// GST state code, e.g. "27" for Maharashtra.
  stateCode     String?  @map("state_code")
  sacCode       String   @default("999723") @map("sac_code")
  /// Invoice numbers look like PREFIX/26-27/0001 (max 16 characters, so 1–5 characters here).
  invoicePrefix String   @default("INV") @map("invoice_prefix")
  contactPhone  String?  @map("contact_phone")
  email         String?
  /// Per-gym settings (e.g. PT late-cancel hours); validated by Zod in the API.
  settings      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users             User[]
  refreshTokens     RefreshToken[]
  consents          Consent[]
  membershipPlans   MembershipPlan[]
  members           Member[]
  memberships       Membership[]
  membershipFreezes MembershipFreeze[]
  payments          Payment[]

  @@map("gyms")
}

/// A person's account at one gym. The same phone can have accounts at several gyms.
model User {
  id        String    @id @default(uuid()) @db.Uuid
  gymId     String    @map("gym_id") @db.Uuid
  /// E.164, e.g. +919876543210
  phone     String
  name      String
  role      Role
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set by the account deletion / anonymisation flow; such users cannot log in.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  gym                Gym                @relation(fields: [gymId], references: [id], onDelete: Restrict)
  refreshTokens      RefreshToken[]
  consents           Consent[]
  member             Member?
  membershipsCreated Membership[]       @relation("MembershipCreatedBy")
  freezesCreated     MembershipFreeze[] @relation("FreezeCreatedBy")
  paymentsRecorded   Payment[]          @relation("PaymentRecordedBy")

  @@unique([gymId, phone])
  @@index([phone])
  @@map("users")
}

/// Login codes. Not tenant-owned: a code is requested before we know which gym the user wants.
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  /// HMAC of phone + code; the code itself is never stored.
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// Rotating refresh tokens. Each login starts a family; reuse of a rotated token revokes the family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  gymId     String    @map("gym_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  /// SHA-256 of the token; the token itself only lives in the user's cookie.
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// DPDP consent records: one row per purpose and notice version accepted.
model Consent {
  id            String         @id @default(uuid()) @db.Uuid
  gymId         String         @map("gym_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  purpose       ConsentPurpose
  noticeVersion String         @map("notice_version")
  grantedAt     DateTime       @default(now()) @map("granted_at") @db.Timestamptz(3)
  withdrawnAt   DateTime?      @map("withdrawn_at") @db.Timestamptz(3)

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([userId])
  @@map("consents")
}

/// A membership plan the gym sells, e.g. "3 months" for ₹4,500 (GST-inclusive).
/// Plans are deactivated, never deleted, so old memberships keep their history.
model MembershipPlan {
  id             String   @id @default(uuid()) @db.Uuid
  gymId          String   @map("gym_id") @db.Uuid
  name           String
  durationMonths Int      @map("duration_months")
  /// GST-inclusive price in paise.
  pricePaise     Int      @map("price_paise")
  maxFreezeDays  Int      @default(0) @map("max_freeze_days")
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@unique([gymId, name])
  @@index([gymId])
  @@map("membership_plans")
}

/// Member profile: one per member user account.
model Member {
  id                    String   @id @default(uuid()) @db.Uuid
  gymId                 String   @map("gym_id") @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  joinedOn              DateTime @map("joined_on") @db.Date
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  memberships Membership[]
  payments    Payment[]

  @@index([gymId])
  @@map("members")
}

/// One purchased membership period. Plan details are copied at sale time so later plan edits
/// don't rewrite history. Status (upcoming/active/frozen/expired/cancelled) is derived from dates.
model Membership {
  id             String    @id @default(uuid()) @db.Uuid
  gymId          String    @map("gym_id") @db.Uuid
  memberId       String    @map("member_id") @db.Uuid
  planId         String    @map("plan_id") @db.Uuid
  planName       String    @map("plan_name")
  durationMonths Int       @map("duration_months")
  pricePaise     Int       @map("price_paise")
  maxFreezeDays  Int       @map("max_freeze_days")
  /// The plan's price at sale; `pricePaise` is lower when a discount was given.
  listPricePaise Int       @map("list_price_paise")
  discountReason String?   @map("discount_reason")
  /// True for memberships sold before the app recorded payments: nothing is due on them.
  paidOutsideApp Boolean   @default(false) @map("paid_outside_app")
  startDate      DateTime  @map("start_date") @db.Date
  /// Last valid day (inclusive), including freeze extensions.
  endDate        DateTime  @map("end_date") @db.Date
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason   String?   @map("cancel_reason")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym       Gym                @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan      MembershipPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy User               @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  freezes   MembershipFreeze[]
  payments  Payment[]

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, endDate])
  @@map("memberships")
}

/// A pause in a membership (inclusive dates). Its length is added to the membership's end date.
model MembershipFreeze {
  id           String   @id @default(uuid()) @db.Uuid
  gymId        String   @map("gym_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  fromDate     DateTime @map("from_date") @db.Date
  toDate       DateTime @map("to_date") @db.Date
  reason       String?
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("FreezeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([membershipId])
  @@map("membership_freezes")
}

enum PaymentMethod {
  cash
  upi
  card
  bank_transfer
  razorpay

  @@map("payment_method")
}

enum PaymentStatus {
  /// Online order created, waiting for Razorpay.
  created
  paid
  failed

  @@map("payment_status")
}

/// Money received (or, for online orders, expected) for a membership. Amounts in paise.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  gymId             String        @map("gym_id") @db.Uuid
  memberId          String        @map("member_id") @db.Uuid
  membershipId      String?       @map("membership_id") @db.Uuid
  amountPaise       Int           @map("amount_paise")
  method            PaymentMethod
  status            PaymentStatus
  /// UPI transaction ID, card slip number, bank reference…
  reference         String?
  note              String?
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  /// Desk staff who took the payment; null for online payments.
  recordedById      String?       @map("recorded_by_id") @db.Uuid
  razorpayOrderId   String?       @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym        Gym         @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  recordedBy User?       @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([memberId])
  @@index([membershipId])
  @@index([gymId, paidAt])
  @@map("payments")
}
