# Copy to apps/api/.env and fill in. Never commit .env.
# Never put real values in THIS file: it is committed to git.

# --- Database (Neon) ---
# Development database, POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Same development database, DIRECT (unpooled) connection string: same host WITHOUT "-pooler". Used by Prisma for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Test database (onthec_test), DIRECT connection string. Tests wipe and recreate data here.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/onthec_test?sslmode=require"

# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated list of web app origins allowed to call the API.
WEB_ORIGINS=http://localhost:5173,http://localhost:4173
