# Copy to apps/api/.env and fill in. Never commit .env.
# Never put real values in THIS file: it is committed to git.

# --- Database (Neon) ---
# Development database, POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Same development database, DIRECT (unpooled) connection string: same host WITHOUT "-pooler". Used by Prisma for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Test database (onthec_test), DIRECT connection string. Tests wipe and recreate data here.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/onthec_test?sslmode=require"

# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated list of web app origins allowed to call the API.
WEB_ORIGINS=http://localhost:5173,http://localhost:4173
# true when deployed behind a proxy (Render, Cloudflare) so rate limits see real client IPs.
TRUST_PROXY=false

# --- Auth ---
# Two different random secrets, at least 32 characters each. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="CHANGE-ME"
OTP_SECRET="CHANGE-ME"
# How login codes are delivered: "console" (written to the API log) or "whatsapp".
OTP_PROVIDER=console
# Optional: numbers that log in with OTP_TEST_CODE (only while OTP_PROVIDER=console).
OTP_TEST_PHONES=
OTP_TEST_CODE=

# --- WhatsApp Cloud API (needed when OTP_PROVIDER=whatsapp) ---
# Step-by-step: docs/WHATSAPP_SETUP.md. Values come from developers.facebook.com → your app → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# Temporary tokens from API Setup expire after 24 hours; use a System User token for anything longer.
WHATSAPP_ACCESS_TOKEN=
# Approved "Authentication" template (Copy code button) and its language.
WHATSAPP_OTP_TEMPLATE=login_code
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v26.0

# --- Seed (pnpm db:seed) ---
# Creates this person as the owner of Onthec Gym. 10-digit mobile number.
SEED_OWNER_PHONE=
SEED_OWNER_NAME=
